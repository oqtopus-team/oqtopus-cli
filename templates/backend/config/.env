# gRPC
GRPC_MAX_RECEIVE_MESSAGE_LENGTH=4194304  # 4MB
GRPC_MAX_SEND_MESSAGE_LENGTH=4194304  # 4MB

# job buffer
JOB_BUFFER=buffer
# JOB_BUFFER=buffer_mp_auto_combining

# job/device fetcher
JOB_FETCHER_INTERVAL_SECONDS=10
JOB_FETCHER_LIMIT=10
JOB_FETCHER_THRESHOLD=10
DEVICE_FETCHER_INITIAL_INTERVAL_SECONDS=10
DEVICE_FETCHER_INITIAL_BACKOFF_MAX_SECONDS=60
DEVICE_FETCHER_LOOP_INTERVAL_SECONDS=60
DEVICE_FETCHER_LOOP_BACKOFF_MAX_SECONDS=300
DEVICE_FETCHER_ENABLE_DEVICE_INFO_UPDATE=true

# job/device repository(OQTOPUS Cloud)
# The device repository URL and API key are set to the same values as the job repository in docker-compose.yml.
JOB_REPOSITORY_URL="http://localhost:8888"
JOB_REPOSITORY_API_KEY=
JOB_REPOSITORY_WORKERS=10
JOB_API_REQUEST_TIMEOUT_SECONDS=10
JOB_FILE_OP_TIMEOUT_SECONDS=60  # Timeout in seconds for job file read/write operations before failing
MAX_FILE_SIZE=10485760  # Maximum upload file size (10MB)

DEVICE_REPOSITORY_WORKERS=10
DEVICE_REPOSITORY_API_REQUEST_TIMEOUT_SECONDS=10

# sse
SSE_ENGINE_ADDRESS="localhost:51014"
SSE_ENGINE_IP_POSTFIX="14"
SSE_HOST_WORK_PATH="sse_work"
SSE_DELETE_HOST_TEMP_DIRS=true
SSE_CONTAINER_PATH="/sse"
SSE_USER_PROGRAM_NAME="userprogram.py"
SSE_RESULT_NAME="result.json"
SSE_LOG_NAME="ssecontainer.log"
SSE_CONTAINER_IMAGE="{{ env_name }}-sse_runtime:latest"
SSE_CONTAINER_DISK_QUOTA=314572800  # 64MB
SSE_CONTAINER_MEMORY=1073741824  # 256MB
SSE_CONTAINER_CPU_SET="0"
# SSE_CONTAINER_NETWORK="{{ env_name }}_context_app_net"
SSE_TIMEOUT=600  # 600 seconds
SSE_MAX_FILE_SIZE=10485760  # 10MB

# mitigator
MITIGATOR_ADDRESS="localhost:51011"
MITIGATOR_WORKERS=10

# estimator
ESTIMATOR_ADDRESS="localhost:51012"
ESTIMATOR_WORKERS=10

# combiner
COMBINER_ADDRESS="localhost:51013"
COMBINER_WORKERS=10
IDLE_QUBITS_INSERTION_ENABLED=false

# mp auto combining
MP_AUTO_BUFFER_MONITOR_INTERVAL_SECONDS=1
MP_AUTO_BUFFER_MAX_BATCH_SIZE=30
MP_AUTO_BUFFER_MAX_QSIZE_TO_PROCEED=5

# tranqu
TRANQU_ADDRESS="localhost:51020"
TRANQU_WORKERS=10

# device gateway
GATEWAY_ADDRESS="localhost:51021"
GATEWAY_WORKERS=2

# ============================================================
# monitoring (optional)
# ============================================================
# true: monitoring ON (starts monitoring containers + OTel auto-instrumentation)
# false: monitoring OFF (services run normally with zero overhead)
MONITORING_ENABLED=false
#
# Optional overrides (defaults are used if not set)
# MONITORING_SERVER=host.docker.internal  # telemetry destination
# DEVICE_ID=qulacs                        # device identifier (also used as instance label)
